# Explicit CLI upload allowlist. dist/ is built from these files on Vercel.
/*
!/vercel.json
!/index.html
!/book.html
!/author.html
!/launch.html
!/styles.css
!/navigation.js
!/scripts
/scripts/*
!/scripts/build-static.cjs
!/scripts/static-files.json
!/assets
/assets/*
!/assets/images
/assets/images/*
!/assets/images/interior.webp
!/assets/images/author-portrait.webp
!/assets/images/book-cover.png
!/assets/images/book-contact-shadow.svg
!/assets/images/delivery
/assets/images/delivery/*
!/assets/images/delivery/interior-1536.avif
!/assets/images/delivery/interior-1536.webp
!/assets/images/delivery/author-1153.avif
!/assets/images/delivery/author-1153.webp
!/assets/fonts
/assets/fonts/*
!/assets/fonts/geist-latin.woff2
!/assets/fonts/OFL.txt
